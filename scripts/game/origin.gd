static func info(id: String) -> Dictionary:
	return ORIGINS.get(id, ORIGINS["street"])


static func care_cost(id: String, worth: float) -> float:
	var c: Array = info(id)["care_cost"]
	var cost: float = maxf(c[0], worth * c[1])
	return roundf(cost / 100.0) * 100.0


## The next story beat whose condition came true, or {}.
static func next_beat(s: RefCounted) -> Dictionary:
	for b in BEATS.get(s.origin, []):
		if s.story.has(b["id"]):
			continue
		if b.get("start", false):
			return b
		if b.has("day") and s.day >= b["day"]:
			return b
		if b.has("rank") and s.rank() >= b["rank"]:
			return b
		if b.get("venue", false) and not s.venues.is_empty():
			return b
		if b.get("home", false) and s.has_home():
			return b
		if b.has("low") and s.mind < b["low"]:
			return b
	return {}
